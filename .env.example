# MongoDB Atlas connection string. Never commit the real value — set it in .env.local (gitignored).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=PlanaltoFutsal
MONGODB_DB_NAME=planalto-futsal

# Auth.js (NextAuth v5). Generate with: npx auth secret
AUTH_SECRET=
# Porta 3001 usada em dev porque a 3000 já está ocupada por outro projeto local.
AUTH_URL=http://localhost:3001

NEXT_PUBLIC_SITE_NAME="Planalto Futsal"

# Resend (envio de e-mail transacional). Crie em resend.com e cole a API key.
# Sem essa chave, os e-mails (verificação de cadastro etc.) só são logados
# no console do servidor — útil em dev, não funciona em produção.
RESEND_API_KEY=
# Precisa ser um remetente de um domínio verificado no Resend. Antes de
# verificar planaltofutsal.com.br lá, pode deixar o padrão de teste
# "Planalto Futsal <onboarding@resend.dev>" (só entrega pro seu próprio
# e-mail de cadastro na Resend).
RESEND_FROM_EMAIL="Planalto Futsal <onboarding@resend.dev>"
