{
  "name": "planalto-futsal",
  "version": "0.1.0",
  "private": true,
  "description": "PWA oficial do Planalto Futsal - Jardim Planalto, Sancho, Zona Oeste do Recife-PE",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
