    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "mongoose": "^8.7.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.25",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "resend": "^4.0.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/bcryptjs": "^2.4.6",
